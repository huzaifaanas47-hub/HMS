{
  "name": "multirole-portal",
  "productName": "Multi-Role Portal",
  "version": "1.0.0",
  "description": "Desktop app with isolated tabs for multiple role logins",
  "main": "main.js",
  "author": "Talha",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
   "build:win": "electron-builder --win nsis --publish never",
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "build": {
    "appId": "com.talha.multiroleportal",
    "productName": "Multi-Role Portal",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}

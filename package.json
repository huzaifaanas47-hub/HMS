{
  "name": "hms",
  "productName": "HMS",
  "version": "3.1.4",
  "description": "HMS - desktop client for the Hospital Management System",
  "main": "main.js",
  "author": {
    "name": "Dr.Talha",
    "email": "huzaifaanas47@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis --publish never",
    "check": "node --check main.js && node --check preload.js && node --check src/origins.js && node --check src/credentials.js && node --check src/policy.js",
    "build:mac": "electron-builder --mac --publish never -c.mac.identity=-",
    "build:linux": "electron-builder --linux AppImage deb --publish never"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.11"
  },
  "homepage": "https://github.com/huzaifaanas47-hub/HMS"
}

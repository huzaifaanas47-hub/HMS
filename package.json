{
  "name": "hms",
  "productName": "HMS",
  "version": "2.0.0",
  "description": "HMS - desktop client for the Hospital Management System",
  "main": "main.js",
  "author": "Dr.Talha",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis --publish never",
    "check": "node --check main.js && node --check preload.js && node --check src/origins.js && node --check src/credentials.js && node --check src/policy.js",
    "build:mac": "electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "build": {
    "appId": "com.talha.HMS",
    "productName": "HMS",
    "files": [
      "main.js",
      "preload.js",
      "app-config.json",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HMS",
      "include": "build/installer.nsh"
    },
    "artifactName": "HMS-Setup-${version}.${ext}",
    "mac": {
      "category": "public.app-category.medical",
      "icon": "build/icon.png",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "HMS-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "HMS pages use the camera, for example to scan or take photos.",
        "NSMicrophoneUsageDescription": "HMS pages use the microphone, for example for calls and voice notes."
      }
    },
    "dmg": {
      "title": "HMS ${version}"
    }
  }
}
